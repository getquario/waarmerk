{
  "name": "waarmerk",
  "version": "0.1.0",
  "description": "Tiny and spoof-proof located diagnostics for JavaScript parsers.",
  "keywords": [
    "diagnostic",
    "error",
    "relocate",
    "source-span"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Robin van der Vleuten",
    "email": "robin@webstronauts.com",
    "url": "https://robinvdvleuten.nl"
  },
  "repository": "getquario/waarmerk",
  "files": [
    "lib"
  ],
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "bench": "node --disallow-code-generation-from-strings bench/index.js",
    "check": "run-s fmt:check lint fallow size test test:browser",
    "commitlint": "commitlint",
    "fallow": "fallow",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "size": "size-limit",
    "test": "run-s test:unit test:types",
    "test:browser": "playwright install chromium && node test/browser/harness.js",
    "test:types": "tsc && attw --pack . --profile esm-only",
    "test:unit": "c8 --100 --src lib/ node --disallow-code-generation-from-strings --test --test-concurrency=1 test/*.test.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "c8": "^12.0.0",
    "fallow": "^3.18.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "size-limit": "^13.0.3",
    "typescript": "7.0.2"
  },
  "size-limit": [
    {
      "path": "lib/index.js",
      "limit": "600 B"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
